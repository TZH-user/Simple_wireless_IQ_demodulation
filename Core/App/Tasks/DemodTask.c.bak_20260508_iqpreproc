#include "DemodTask.h"

#include <string.h>

#include "adc.h"
#include "app_demod.h"
#include "RtosTypes.h"

typedef struct
{
    uint16_t i_buf[ADC_BLOCK_N];
    uint16_t q_buf[ADC_BLOCK_N];
    uint32_t sample_cnt;
    uint32_t demod_lo_hz;
    uint32_t carrier_hz;
    uint32_t sequence;
    uint32_t tick_ms;
    uint8_t in_use;
} demod_snapshot_t;

__attribute__((section(".demod_buffer"))) __attribute__((aligned(32)))
static demod_snapshot_t g_demod_slots[DEMOD_SNAPSHOT_SLOT_COUNT];

static demod_task_stats_t g_demod_stats;
static uint32_t g_demod_next_sequence = 1U;
static volatile uint8_t g_demod_task_enabled = 0U;

static int32_t demod_task_claim_slot(void)
{
    int32_t slot = -1;
    uint32_t primask = __get_PRIMASK();

    __disable_irq();
    for (uint32_t idx = 0U; idx < DEMOD_SNAPSHOT_SLOT_COUNT; idx++)
    {
        if (g_demod_slots[idx].in_use == 0U)
        {
            g_demod_slots[idx].in_use = 1U;
            slot = (int32_t)idx;
            break;
        }
    }
    __set_PRIMASK(primask);

    return slot;
}

static void demod_task_release_slot(uint32_t slot)
{
    if (slot >= DEMOD_SNAPSHOT_SLOT_COUNT)
    {
        return;
    }

    {
        uint32_t primask = __get_PRIMASK();

        __disable_irq();
        g_demod_slots[slot].in_use = 0U;
        __set_PRIMASK(primask);
    }
}

uint32_t demod_task_submit_block(const uint16_t *i_buf,
                                 const uint16_t *q_buf,
                                 uint32_t sample_cnt,
                                 uint32_t demod_lo_hz,
                                 uint32_t carrier_hz,
                                 uint32_t tick_ms)
{
    int32_t slot;
    uint32_t slot_index;
    demod_snapshot_t *snapshot;

    if ((i_buf == NULL) || (q_buf == NULL) || (sample_cnt == 0U) ||
        (sample_cnt > ADC_BLOCK_N) || (DemodQueueHandle == NULL))
    {
        return 0U;
    }

    slot = demod_task_claim_slot();
    if (slot < 0)
    {
        g_demod_stats.submit_drop_cnt++;
        return 0U;
    }

    slot_index = (uint32_t)slot;
    snapshot = &g_demod_slots[slot_index];

    memcpy(snapshot->i_buf, i_buf, sample_cnt * sizeof(uint16_t));
    memcpy(snapshot->q_buf, q_buf, sample_cnt * sizeof(uint16_t));
    snapshot->sample_cnt = sample_cnt;
    snapshot->demod_lo_hz = demod_lo_hz;
    snapshot->carrier_hz = carrier_hz;
    snapshot->tick_ms = tick_ms;
    snapshot->sequence = g_demod_next_sequence++;

    if (osMessageQueuePut(DemodQueueHandle, &slot_index, 0U, 0U) != osOK)
    {
        g_demod_stats.queue_full_drop_cnt++;
        demod_task_release_slot(slot_index);
        return 0U;
    }

    g_demod_stats.submit_ok_cnt++;
    g_demod_stats.last_sequence = snapshot->sequence;
    return 1U;
}

void demod_task_get_stats(demod_task_stats_t *stats_out)
{
    if (stats_out == NULL)
    {
        return;
    }

    *stats_out = g_demod_stats;
}

void demod_task_set_enabled(uint8_t enabled)
{
    g_demod_task_enabled = (enabled != 0U) ? 1U : 0U;

    if ((g_demod_task_enabled != 0U) && (DemodTaskHandle != NULL))
    {
        (void)osThreadResume(DemodTaskHandle);
    }
}


void StartDemodTask(void *argument)
{
    uint32_t slot_index;

    (void)argument;

    memset(g_demod_slots, 0, sizeof(g_demod_slots));
    memset(&g_demod_stats, 0, sizeof(g_demod_stats));

    app_demod_reset_output();
    
    for (;;)
    {
        if (g_demod_task_enabled == 0U)
        {
            osThreadSuspend(DemodTaskHandle);
            continue;
        }

        if (osMessageQueueGet(DemodQueueHandle, &slot_index, NULL, 20U) != osOK)
        {
            continue;
        }

        if (slot_index >= DEMOD_SNAPSHOT_SLOT_COUNT)
        {
            continue;
        }

        if (g_demod_task_enabled == 0U)
        {
            demod_task_release_slot(slot_index);
            continue;
        }

        app_demod_process_iq_block(g_demod_slots[slot_index].i_buf,
                                   g_demod_slots[slot_index].q_buf,
                                   g_demod_slots[slot_index].sample_cnt,
                                   g_demod_slots[slot_index].demod_lo_hz,
                                   g_demod_slots[slot_index].carrier_hz,
                                   g_demod_slots[slot_index].tick_ms);

        g_demod_stats.process_cnt++;
        demod_task_release_slot(slot_index);
    }
}
