#include "app_baseband_spectrum.h"

#include <math.h>
#include <stdio.h>
#include <string.h>

#include "cmsis_os2.h"
#include "main.h"
#include "RtosTypes.h"

#define APP_BBSP_DEFAULT_DECIMATION      16U
#define APP_BBSP_SUBMIT_PERIOD_MS        80U
#define APP_BBSP_LOG_PERIOD_MS         1000U
#define APP_BBSP_ADC_MID_CODE         8192.0f
#define APP_BBSP_MIN_SIGNAL_MAG2         1.0f
#define APP_BBSP_BIN_COUNT             (APP_BBSP_SNAPSHOT_POINTS / 2U)
#define APP_BBSP_PI                    3.14159265358979323846f

typedef enum
{
  APP_BBSP_PENDING_EMPTY = 0,
  APP_BBSP_PENDING_FILLING,
  APP_BBSP_PENDING_READY,
  APP_BBSP_PENDING_BUSY
} app_bbsp_pending_state_t;

typedef struct
{
  uint32_t input_sample_rate_hz;
  uint32_t pending_sample_rate_hz;
  uint32_t pending_lo_hz;
  uint32_t pending_carrier_hz;
  uint32_t pending_epoch;
  uint32_t last_submit_tick;
  uint32_t epoch;
  uint8_t pending_state;
  uint8_t reserved[3];
  uint16_t pending_i[APP_BBSP_SNAPSHOT_POINTS];
  uint16_t pending_q[APP_BBSP_SNAPSHOT_POINTS];
  float work_i[APP_BBSP_SNAPSHOT_POINTS];
  float work_q[APP_BBSP_SNAPSHOT_POINTS];
  app_baseband_spectrum_status_t status;
} app_bbsp_ctx_t;

static app_bbsp_ctx_t g_bbsp;

static uint8_t app_bbsp_try_claim_for_fill(uint32_t *epoch_out)
{
  uint8_t ok = 0U;
  uint32_t primask = __get_PRIMASK();
  __disable_irq();
  if (g_bbsp.pending_state == APP_BBSP_PENDING_EMPTY)
  {
    g_bbsp.pending_state = APP_BBSP_PENDING_FILLING;
    *epoch_out = g_bbsp.epoch;
    ok = 1U;
  }
  __set_PRIMASK(primask);
  return ok;
}

static uint8_t app_bbsp_try_claim_for_process(uint32_t *epoch_out,
                                              uint32_t *sample_rate_hz_out,
                                              uint32_t *lo_hz_out,
                                              uint32_t *carrier_hz_out)
{
  uint8_t ok = 0U;
  uint32_t primask = __get_PRIMASK();
  __disable_irq();
  if (g_bbsp.pending_state == APP_BBSP_PENDING_READY)
  {
    g_bbsp.pending_state = APP_BBSP_PENDING_BUSY;
    *epoch_out = g_bbsp.pending_epoch;
    *sample_rate_hz_out = g_bbsp.pending_sample_rate_hz;
    *lo_hz_out = g_bbsp.pending_lo_hz;
    *carrier_hz_out = g_bbsp.pending_carrier_hz;
    ok = 1U;
  }
  __set_PRIMASK(primask);
  return ok;
}

static void app_bbsp_clear_status_keep_fs(void)
{
  g_bbsp.status.valid = 0U;
  g_bbsp.status.block_count = 0U;
  g_bbsp.status.peak_hz = 0U;
  g_bbsp.status.peak_mag = 0U;
  g_bbsp.status.noise_floor = 0U;
  g_bbsp.status.dc_mag = 0U;
  g_bbsp.status.lo_hz = 0U;
  g_bbsp.status.carrier_hz = 0U;
}

void app_baseband_spectrum_init(uint32_t input_sample_rate_hz)
{
  memset(&g_bbsp, 0, sizeof(g_bbsp));
  g_bbsp.input_sample_rate_hz = input_sample_rate_hz;
  g_bbsp.status.sample_rate_hz = input_sample_rate_hz / APP_BBSP_DEFAULT_DECIMATION;
  g_bbsp.epoch = 1U;
}

void app_baseband_spectrum_invalidate(void)
{
  uint32_t primask = __get_PRIMASK();
  __disable_irq();
  g_bbsp.epoch++;
  if ((g_bbsp.pending_state == APP_BBSP_PENDING_READY) ||
      (g_bbsp.pending_state == APP_BBSP_PENDING_FILLING))
  {
    g_bbsp.pending_state = APP_BBSP_PENDING_EMPTY;
  }
  app_bbsp_clear_status_keep_fs();
  __set_PRIMASK(primask);
}

uint8_t app_baseband_spectrum_submit_iq_block(const uint16_t *i_buf,
                                              const uint16_t *q_buf,
                                              uint32_t sample_cnt,
                                              uint32_t lo_hz,
                                              uint32_t carrier_hz)
{
  uint32_t now_tick;
  uint32_t stride;
  uint32_t effective_rate_hz;
  uint32_t epoch;

  if ((i_buf == NULL) || (q_buf == NULL) || (sample_cnt < APP_BBSP_SNAPSHOT_POINTS))
  {
    return 0U;
  }

  now_tick = osKernelGetTickCount();
  if ((g_bbsp.last_submit_tick != 0U) &&
      ((uint32_t)(now_tick - g_bbsp.last_submit_tick) < APP_BBSP_SUBMIT_PERIOD_MS))
  {
    return 0U;
  }

  stride = sample_cnt / APP_BBSP_SNAPSHOT_POINTS;
  if (stride == 0U)
  {
    stride = 1U;
  }
  effective_rate_hz = (stride > 0U) ? (g_bbsp.input_sample_rate_hz / stride) : g_bbsp.input_sample_rate_hz;

  if (app_bbsp_try_claim_for_fill(&epoch) == 0U)
  {
    return 0U;
  }

  for (uint32_t i = 0U; i < APP_BBSP_SNAPSHOT_POINTS; i++)
  {
    uint32_t src_index = i * stride;
    if (src_index >= sample_cnt)
    {
      src_index = sample_cnt - 1U;
    }
    g_bbsp.pending_i[i] = i_buf[src_index];
    g_bbsp.pending_q[i] = q_buf[src_index];
  }

  {
    uint32_t primask = __get_PRIMASK();
    __disable_irq();
    g_bbsp.pending_sample_rate_hz = effective_rate_hz;
    g_bbsp.pending_lo_hz = lo_hz;
    g_bbsp.pending_carrier_hz = carrier_hz;
    g_bbsp.pending_epoch = epoch;
    g_bbsp.pending_state = APP_BBSP_PENDING_READY;
    __set_PRIMASK(primask);
  }

  g_bbsp.last_submit_tick = now_tick;
  return 1U;
}

uint8_t app_baseband_spectrum_run_once(void)
{
  uint32_t snapshot_epoch;
  uint32_t sample_rate_hz;
  uint32_t lo_hz;
  uint32_t carrier_hz;
  float mean_i = 0.0f;
  float mean_q = 0.0f;
  float dc_i;
  float dc_q;
  float dc_mag;
  float signal_mag2 = 0.0f;
  float peak_mag2 = 0.0f;
  float noise_mag2_sum = 0.0f;
  uint32_t peak_bin = 0U;
  uint32_t bin_count = 0U;
  uint8_t valid = 0U;

  if (app_bbsp_try_claim_for_process(&snapshot_epoch, &sample_rate_hz, &lo_hz, &carrier_hz) == 0U)
  {
    return 0U;
  }

  for (uint32_t i = 0U; i < APP_BBSP_SNAPSHOT_POINTS; i++)
  {
    mean_i += (float)g_bbsp.pending_i[i];
    mean_q += (float)g_bbsp.pending_q[i];
  }
  mean_i /= (float)APP_BBSP_SNAPSHOT_POINTS;
  mean_q /= (float)APP_BBSP_SNAPSHOT_POINTS;

  dc_i = mean_i - APP_BBSP_ADC_MID_CODE;
  dc_q = mean_q - APP_BBSP_ADC_MID_CODE;
  dc_mag = sqrtf((dc_i * dc_i) + (dc_q * dc_q));

  for (uint32_t i = 0U; i < APP_BBSP_SNAPSHOT_POINTS; i++)
  {
    float ci = (float)g_bbsp.pending_i[i] - mean_i;
    float cq = (float)g_bbsp.pending_q[i] - mean_q;
    g_bbsp.work_i[i] = ci;
    g_bbsp.work_q[i] = cq;
    signal_mag2 += (ci * ci) + (cq * cq);
  }

  if (signal_mag2 > APP_BBSP_MIN_SIGNAL_MAG2)
  {
    for (uint32_t k = 1U; k <= APP_BBSP_BIN_COUNT; k++)
    {
      float angle_step = (-2.0f * APP_BBSP_PI * (float)k) / (float)APP_BBSP_SNAPSHOT_POINTS;
      float cos_step = cosf(angle_step);
      float sin_step = sinf(angle_step);
      float wr = 1.0f;
      float wi = 0.0f;
      float sum_r = 0.0f;
      float sum_i = 0.0f;

      for (uint32_t n = 0U; n < APP_BBSP_SNAPSHOT_POINTS; n++)
      {
        float xr = g_bbsp.work_i[n];
        float xi = g_bbsp.work_q[n];
        float next_wr;
        float next_wi;

        sum_r += (xr * wr) - (xi * wi);
        sum_i += (xr * wi) + (xi * wr);

        next_wr = (wr * cos_step) - (wi * sin_step);
        next_wi = (wr * sin_step) + (wi * cos_step);
        wr = next_wr;
        wi = next_wi;
      }

      {
        float mag2 = (sum_r * sum_r) + (sum_i * sum_i);
        noise_mag2_sum += mag2;
        bin_count++;
        if (mag2 > peak_mag2)
        {
          peak_mag2 = mag2;
          peak_bin = k;
        }
      }
    }

    valid = (peak_bin > 0U) ? 1U : 0U;
  }

  {
    uint32_t peak_mag = 0U;
    uint32_t noise_floor = 0U;
    uint32_t peak_hz = 0U;
    uint32_t dc_mag_u32 = (uint32_t)(dc_mag + 0.5f);
    uint32_t primask = __get_PRIMASK();
    __disable_irq();
    g_bbsp.pending_state = APP_BBSP_PENDING_EMPTY;
    if (snapshot_epoch == g_bbsp.epoch)
    {
      if (valid != 0U)
      {
        float avg_noise_mag2 = 0.0f;
        peak_mag = (uint32_t)((sqrtf(peak_mag2) / (float)APP_BBSP_SNAPSHOT_POINTS) + 0.5f);
        if (bin_count > 1U)
        {
          avg_noise_mag2 = (noise_mag2_sum - peak_mag2) / (float)(bin_count - 1U);
        }
        if (avg_noise_mag2 < 0.0f)
        {
          avg_noise_mag2 = 0.0f;
        }
        noise_floor = (uint32_t)((sqrtf(avg_noise_mag2) / (float)APP_BBSP_SNAPSHOT_POINTS) + 0.5f);
        peak_hz = (uint32_t)((((uint64_t)peak_bin * (uint64_t)sample_rate_hz) +
                              (APP_BBSP_SNAPSHOT_POINTS / 2U)) /
                             APP_BBSP_SNAPSHOT_POINTS);
      }

      g_bbsp.status.valid = valid;
      g_bbsp.status.block_count++;
      g_bbsp.status.sample_rate_hz = sample_rate_hz;
      g_bbsp.status.peak_hz = peak_hz;
      g_bbsp.status.peak_mag = peak_mag;
      g_bbsp.status.noise_floor = noise_floor;
      g_bbsp.status.dc_mag = dc_mag_u32;
      g_bbsp.status.lo_hz = lo_hz;
      g_bbsp.status.carrier_hz = carrier_hz;
    }
    __set_PRIMASK(primask);
  }

  return 1U;
}

void app_baseband_spectrum_log_1s(void)
{
  static uint32_t last_log_tick = 0U;
  uint32_t now_tick = osKernelGetTickCount();
  app_baseband_spectrum_status_t st;
  char line[125];
  int n;

  if ((last_log_tick != 0U) &&
      ((uint32_t)(now_tick - last_log_tick) < APP_BBSP_LOG_PERIOD_MS))
  {
    return;
  }
  last_log_tick = now_tick;

  if (g_uart_mode != UART_MODE_LOG)
  {
    return;
  }

  app_baseband_spectrum_get_status(&st);
  n = snprintf(line,
               sizeof(line),
               "bbsp,valid=%u,peak=%lu,mag=%lu,noise=%lu,dc=%lu,blk=%lu\r\n",
               (unsigned)st.valid,
               (unsigned long)st.peak_hz,
               (unsigned long)st.peak_mag,
               (unsigned long)st.noise_floor,
               (unsigned long)st.dc_mag,
               (unsigned long)st.block_count);
  if ((n > 0) && ((size_t)n < sizeof(line)))
  {
    print_queue_send_log(line);
  }
}

void app_baseband_spectrum_get_status(app_baseband_spectrum_status_t *out)
{
  uint32_t primask;

  if (out == NULL)
  {
    return;
  }

  primask = __get_PRIMASK();
  __disable_irq();
  memcpy(out, &g_bbsp.status, sizeof(*out));
  __set_PRIMASK(primask);
}