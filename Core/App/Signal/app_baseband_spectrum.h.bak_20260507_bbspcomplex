#ifndef APP_BASEBAND_SPECTRUM_H
#define APP_BASEBAND_SPECTRUM_H

#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

#define APP_BBSP_SNAPSHOT_POINTS 256U

typedef struct
{
  uint8_t valid;
  uint8_t reserved[3];
  uint32_t block_count;
  uint32_t sample_rate_hz;
  uint32_t peak_hz;
  uint32_t peak_mag;
  uint32_t noise_floor;
  uint32_t dc_mag;
  uint32_t lo_hz;
  uint32_t carrier_hz;
} app_baseband_spectrum_status_t;

void app_baseband_spectrum_init(uint32_t input_sample_rate_hz);
void app_baseband_spectrum_invalidate(void);
uint8_t app_baseband_spectrum_submit_iq_block(const uint16_t *i_buf,
                                              const uint16_t *q_buf,
                                              uint32_t sample_cnt,
                                              uint32_t lo_hz,
                                              uint32_t carrier_hz);
uint8_t app_baseband_spectrum_run_once(void);
void app_baseband_spectrum_log_1s(void);
void app_baseband_spectrum_get_status(app_baseband_spectrum_status_t *out);

#ifdef __cplusplus
}
#endif

#endif