/* 鍒濆鍖栨壂棰戞娴嬪櫒锛屽苟绔嬪嵆浠庣矖鎵樁娈靛紑濮嬨€?*/
void app_signal_detect_init(void)
{
  /* 鍑芥暟璺宠浆锛氳皟鐢?memset()锛屾竻闆剁粨鏋勪綋鎴栨暟缁勶紝閬垮厤涓婁竴闃舵娈嬬暀鏁版嵁褰卞搷褰撳墠娴佺▼銆?*/
  memset(&g_sigdet, 0, sizeof(g_sigdet));
  /* 鍑芥暟璺宠浆锛氳皟鐢?app_signal_detect_begin_scan()锛屾棫鐗?鍏煎閫昏緫浠庣矖鎵噸鏂板紑濮嬨€?*/
  app_signal_detect_begin_scan();
  g_sigdet.inited = 1U;
}

void app_signal_detect_request_rescan(void)
{
  /* 鍒ゆ柇锛歚g_sigdet.inited == 0U`銆傚惈涔夛細鐢ㄤ簬闃茬┖鎸囬拡銆佹湭鍒濆鍖栥€佽鏁颁负 0 鎴栧紑鍏冲叧闂瓑杈圭晫鏉′欢锛涙垚绔嬪悗鐩存帴杩斿洖/閫€鍑哄綋鍓嶅嚱鏁版垨杩斿洖鎸囧畾缁撴灉銆?*/
  if (g_sigdet.inited == 0U)
  {
    return;
  }

  /* 鍑芥暟璺宠浆锛氳皟鐢?app_signal_detect_begin_scan()锛屾棫鐗?鍏煎閫昏緫浠庣矖鎵噸鏂板紑濮嬨€?*/
  app_signal_detect_begin_scan();
}

/*
 * 鎵鏈熼棿鐨?ADC block 鍏ュ彛銆?
 * 姣忎釜棰戠偣绱 scan_dwell_blocks 涓?block 鍚庯紝璁＄畻璇ラ鐐圭殑骞冲潎 Vpp锛?
 * 鍐嶅垏鎹㈠埌涓嬩竴涓?LO 棰戠偣鎴栫粨鏉熸湰杞壂棰戙€?
 */
void app_signal_detect_process_block(const uint16_t *i_buf, const uint16_t *q_buf, uint32_t sample_cnt)
{
  app_signal_detect_vpp_t vpp;
  uint32_t avg_vpp;
  uint32_t avg_i_vpp;
  uint32_t avg_q_vpp;

  /* 鍒ゆ柇锛歚(g_sigdet.inited == 0U) || (g_sigdet.status.scanning == 0U)`銆傚惈涔夛細鐢ㄤ簬闃茬┖鎸囬拡銆佹湭鍒濆鍖栥€佽鏁颁负 0 鎴栧紑鍏冲叧闂瓑杈圭晫鏉′欢锛涙垚绔嬪悗鐩存帴杩斿洖/閫€鍑哄綋鍓嶅嚱鏁版垨杩斿洖鎸囧畾缁撴灉銆?*/
  if ((g_sigdet.inited == 0U) || (g_sigdet.status.scanning == 0U))
  {
    return;
  }

  /* 鍑芥暟璺宠浆锛氳皟鐢?app_signal_detect_block_vpp()锛屾棫鐗?鍏煎閫昏緫缁熻 ADC block 鐨?Vpp銆?*/
  vpp = app_signal_detect_block_vpp(i_buf, q_buf, sample_cnt);
  g_sigdet.step_vpp_sum += vpp.metric_vpp;
  g_sigdet.step_i_vpp_sum += vpp.i_vpp;
  g_sigdet.step_q_vpp_sum += vpp.q_vpp;
  g_sigdet.step_dwell_count++;

  /* 鍒ゆ柇锛歚g_sigdet.step_dwell_count < g_sigdet.scan_dwell_blocks`銆傚惈涔夛細鍐冲畾鏄惁杩涘叆涓嬮潰鐨勫ぇ鎷彿鍒嗘敮锛涙垚绔嬪悗鐩存帴杩斿洖/閫€鍑哄綋鍓嶅嚱鏁版垨杩斿洖鎸囧畾缁撴灉銆?*/
  if (g_sigdet.step_dwell_count < g_sigdet.scan_dwell_blocks)
  {
    return;
  }

  /* avg_vpp 鏄綋鍓嶉鐐?dwell 鍐?max(I_Vpp, Q_Vpp) 鐨勫钩鍧囧€笺€?*/
  avg_vpp = (uint32_t)(g_sigdet.step_vpp_sum / g_sigdet.step_dwell_count);
  avg_i_vpp = (uint32_t)(g_sigdet.step_i_vpp_sum / g_sigdet.step_dwell_count);
  avg_q_vpp = (uint32_t)(g_sigdet.step_q_vpp_sum / g_sigdet.step_dwell_count);
  /* 鍑芥暟璺宠浆锛氳皟鐢?app_signal_detect_finish_step()锛屾棫鐗?鍏煎閫昏緫璁板綍涓€涓鐐圭粨鏋滃苟鏇存柊宄拌胺銆?*/
  app_signal_detect_finish_step(avg_vpp, avg_i_vpp, avg_q_vpp);

  g_sigdet.step_vpp_sum = 0ULL;
  g_sigdet.step_i_vpp_sum = 0ULL;
  g_sigdet.step_q_vpp_sum = 0ULL;
  g_sigdet.step_dwell_count = 0U;

  /* 鍒ゆ柇锛歚(g_sigdet.status.step_index + 1U) < g_sigdet.status.step_count`銆傚惈涔夛細鍐冲畾鏄惁杩涘叆涓嬮潰鐨勫ぇ鎷彿鍒嗘敮锛涙垚绔嬪悗鏇存柊鐩稿叧鐘舵€佸彉閲?杈撳嚭瀛楁锛岀劧鍚庣户缁悗缁祦绋嬨€?*/
  if ((g_sigdet.status.step_index + 1U) < g_sigdet.status.step_count)
  {
    g_sigdet.status.step_index++;
    /* 鍑芥暟璺宠浆锛氳皟鐢?app_signal_detect_step_freq_hz()锛屾棫鐗?鍏煎閫昏緫鐢辩储寮曟崲绠楅鐜囥€?*/
    g_sigdet.status.current_lo_hz = app_signal_detect_step_freq_hz(g_sigdet.scan_start_hz,
                                                                    g_sigdet.scan_step_hz,
                                                                    g_sigdet.status.step_index);
    /* 鍑芥暟璺宠浆锛氳皟鐢?app_signal_detect_set_lo()锛屾棫鐗?鍏煎閫昏緫璋冪敤 DDS 璁剧疆 LO銆?*/
    app_signal_detect_set_lo(g_sigdet.status.current_lo_hz);
    return;
  }

  /* 鍑芥暟璺宠浆锛氳皟鐢?app_signal_detect_finish_current_sweep()锛屾棫鐗?鍏煎閫昏緫缁撴潫褰撳墠鎵闃舵銆?*/
  app_signal_detect_finish_current_sweep();
}

void app_signal_detect_get_status(app_signal_detect_status_t *status_out)
{
  /* 鍒ゆ柇锛歚status_out == 0`銆傚惈涔夛細鐢ㄤ簬闃茬┖鎸囬拡銆佹湭鍒濆鍖栥€佽鏁颁负 0 鎴栧紑鍏冲叧闂瓑杈圭晫鏉′欢锛涙垚绔嬪悗鐩存帴杩斿洖/閫€鍑哄綋鍓嶅嚱鏁版垨杩斿洖鎸囧畾缁撴灉銆?*/
  if (status_out == 0)
  {
    return;
  }

  *status_out = g_sigdet.status;
}

