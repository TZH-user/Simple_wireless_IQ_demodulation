/* 缁熻涓€涓?ADC block 鐨?I/Q 宄板嘲鍊硷紝骞跺彇杈冨ぇ涓€璺綔涓烘壂棰戝己搴︽寚鏍囥€?*/
static app_signal_detect_vpp_t app_signal_detect_block_vpp(const uint16_t *i_buf,
                                                           const uint16_t *q_buf,
                                                           uint32_t sample_cnt)
{
  app_signal_detect_vpp_t out;
  uint32_t idx;
  uint16_t i_min;
  uint16_t i_max;
  uint16_t q_min;
  uint16_t q_max;

  /* 鍑芥暟璺宠浆锛氳皟鐢?memset()锛屾竻闆剁粨鏋勪綋鎴栨暟缁勶紝閬垮厤涓婁竴闃舵娈嬬暀鏁版嵁褰卞搷褰撳墠娴佺▼銆?*/
  memset(&out, 0, sizeof(out));

  /* 鍒ゆ柇锛歚(i_buf == 0) || (q_buf == 0) || (sample_cnt == 0U)`銆傚惈涔夛細鐢ㄤ簬闃茬┖鎸囬拡銆佹湭鍒濆鍖栥€佽鏁颁负 0 鎴栧紑鍏冲叧闂瓑杈圭晫鏉′欢锛涘垽鏂牱鏈暟閲忔槸鍚﹁冻澶熻繘琛屽綋鍓嶇粺璁★紱鎴愮珛鍚庣洿鎺ヨ繑鍥?閫€鍑哄綋鍓嶅嚱鏁版垨杩斿洖鎸囧畾缁撴灉銆?*/
  if ((i_buf == 0) || (q_buf == 0) || (sample_cnt == 0U))
  {
    return out;
  }

  i_min = i_buf[0];   i_max = i_buf[0];
  q_min = q_buf[0];   q_max = q_buf[0];

  for (idx = 1U; idx < sample_cnt; idx++)
  {
    uint16_t i_sample = i_buf[idx];
    uint16_t q_sample = q_buf[idx];

    /* 鍒ゆ柇锛歚i_sample < i_min`銆傚惈涔夛細鏇存柊褰撳墠 block 鐨?I/Q 鏈€灏忓€兼垨鏈€澶у€硷紱鎴愮珛鍚庢洿鏂扮浉鍏崇姸鎬佸彉閲?杈撳嚭瀛楁锛岀劧鍚庣户缁悗缁祦绋嬨€?*/
    if (i_sample < i_min)
    {
      i_min = i_sample;
    }
    /* 鍒ゆ柇锛歚i_sample > i_max`銆傚惈涔夛細鏇存柊褰撳墠 block 鐨?I/Q 鏈€灏忓€兼垨鏈€澶у€硷紱鎴愮珛鍚庢洿鏂扮浉鍏崇姸鎬佸彉閲?杈撳嚭瀛楁锛岀劧鍚庣户缁悗缁祦绋嬨€?*/
    if (i_sample > i_max)
    {
      i_max = i_sample;
    }
    /* 鍒ゆ柇锛歚q_sample < q_min`銆傚惈涔夛細鏇存柊褰撳墠 block 鐨?I/Q 鏈€灏忓€兼垨鏈€澶у€硷紱鎴愮珛鍚庢洿鏂扮浉鍏崇姸鎬佸彉閲?杈撳嚭瀛楁锛岀劧鍚庣户缁悗缁祦绋嬨€?*/
    if (q_sample < q_min)
    {
      q_min = q_sample;
    }
    /* 鍒ゆ柇锛歚q_sample > q_max`銆傚惈涔夛細鏇存柊褰撳墠 block 鐨?I/Q 鏈€灏忓€兼垨鏈€澶у€硷紱鎴愮珛鍚庢洿鏂扮浉鍏崇姸鎬佸彉閲?杈撳嚭瀛楁锛岀劧鍚庣户缁悗缁祦绋嬨€?*/
    if (q_sample > q_max)
    {
      q_max = q_sample;
    }
  }

  out.i_vpp = (uint32_t)i_max - (uint32_t)i_min;
  out.q_vpp = (uint32_t)q_max - (uint32_t)q_min;
  out.metric_vpp = (out.i_vpp > out.q_vpp) ? out.i_vpp : out.q_vpp;

  return out;
}

