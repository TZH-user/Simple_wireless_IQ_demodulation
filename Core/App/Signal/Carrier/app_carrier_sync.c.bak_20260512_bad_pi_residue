#include "app_carrier_sync.h"

#include <string.h>

#include "cmsis_os2.h"
#include "dac.h"

/* VRFE 控制电压中心点，单位 uV；1590000uV 等效 1.590V。 */
/* 条件编译判断：如果该宏尚未定义，则进入头文件内容/对应编译块。 */
#ifndef APP_CARRIER_SYNC_CENTER_UV
/* 宏定义说明：APP_CARRIER_SYNC_CENTER_UV = 1590000；载波同步 DAC 的中心控制电压，复位或失锁时回到这个电压。 */
#define APP_CARRIER_SYNC_CENTER_UV 1590000
#endif

/* 第一版只允许在中心点附近小范围慢速调整，避免把 OCXO 控制端拉到危险区域。 */
/* 条件编译判断：如果该宏尚未定义，则进入头文件内容/对应编译块。 */
#ifndef APP_CARRIER_SYNC_MIN_UV
/* 宏定义说明：APP_CARRIER_SYNC_MIN_UV = 1400000；载波同步 DAC 允许输出的最小电压下限，防止控制量继续往低处跑。 */
#define APP_CARRIER_SYNC_MIN_UV 1400000
#endif

/* 条件编译判断：如果该宏尚未定义，则进入头文件内容/对应编译块。 */
#ifndef APP_CARRIER_SYNC_MAX_UV
/* 宏定义说明：APP_CARRIER_SYNC_MAX_UV = 1700000；载波同步 DAC 允许输出的最大电压上限，防止控制量继续往高处跑。 */
#define APP_CARRIER_SYNC_MAX_UV 1700000
#endif

/* 条件编译判断：如果工程未覆盖频率环执行节拍，则使用默认值。 */
#ifndef APP_CARRIER_SYNC_FREQ_UPDATE_PERIOD_MS
/* 宏定义说明：频率闭环执行节拍，单位 ms；只决定多久计算一次控制输出，不再直接代表积分强度。 */
#define APP_CARRIER_SYNC_FREQ_UPDATE_PERIOD_MS 20U
#endif

/* 条件编译判断：如果工程未覆盖频率环积分斜率，则使用默认值。 */
#ifndef APP_CARRIER_SYNC_FREQ_SLEW_UV_PER_SEC
/* 宏定义说明：频率闭环输出限速，单位 uV/s；只限制 PI 输出变化速度，不是 PI 的 Ki。 */
#define APP_CARRIER_SYNC_FREQ_SLEW_UV_PER_SEC 5000L
#endif

/* 条件编译判断：如果工程未覆盖 P 增益，则使用默认值。 */
#ifndef APP_CARRIER_SYNC_FREQ_KP_UV_PER_HZ
/* 宏定义说明：频率 PI 的 P 增益，单位 uV/Hz；频偏越大，P 项给出的即时电压偏置越大。 */
#define APP_CARRIER_SYNC_FREQ_KP_UV_PER_HZ 2L
#endif

/* 条件编译判断：如果工程未覆盖 I 增益，则使用默认值。 */
#ifndef APP_CARRIER_SYNC_FREQ_KI_UV_PER_HZ_S
/* 宏定义说明：频率 PI 的 I 增益，单位 uV/(Hz*s)；残余频偏持续存在时，I 项按时间累加以消除静差。 */
#define APP_CARRIER_SYNC_FREQ_KI_UV_PER_HZ_S 50L
#endif

/* 残余频偏死区，单位 mHz；死区内不调整 VRFE，降低抖动。 */
/* 条件编译判断：如果该宏尚未定义，则进入头文件内容/对应编译块。 */
#ifndef APP_CARRIER_SYNC_DEADBAND_MHZ
/* 宏定义说明：APP_CARRIER_SYNC_DEADBAND_MHZ = 0；残余频偏死区，误差绝对值小于等于该值时不再调整 DAC。 */
#define APP_CARRIER_SYNC_DEADBAND_MHZ 100
#endif

/* 条件编译判断：保留旧宏名作为兼容入口，旧工程若覆盖该宏则映射为频率环积分斜率。 */
#ifdef APP_CARRIER_SYNC_STEP_UV
/* 宏定义说明：旧参数 APP_CARRIER_SYNC_STEP_UV 仅作兼容；新代码优先使用 APP_CARRIER_SYNC_FREQ_SLEW_UV_PER_SEC。 */
#undef APP_CARRIER_SYNC_FREQ_SLEW_UV_PER_SEC
#define APP_CARRIER_SYNC_FREQ_SLEW_UV_PER_SEC ((int32_t)(APP_CARRIER_SYNC_STEP_UV) * 1000L)
#endif

/*
 * 控制极性：
 *   +1：残余频偏为正时提高 VRFE 电压
 *   -1：残余频偏为正时降低 VRFE 电压
 * 若实测闭环方向相反，只改这个宏，不改扫频和 ADC 任务结构。
 */
/* 条件编译判断：如果该宏尚未定义，则进入头文件内容/对应编译块。 */
#ifndef APP_CARRIER_SYNC_CONTROL_POLARITY
/* 宏定义说明：APP_CARRIER_SYNC_CONTROL_POLARITY = 1；载波同步控制极性；决定残余频偏为正/负时 DAC 应该加还是减。 */
#define APP_CARRIER_SYNC_CONTROL_POLARITY 1
#endif

/* 宏定义说明：APP_CARRIER_SYNC_DAC_MAX_CODE = 4095U；12 位 DAC 的最大数字码值，用于把微伏换算成 DAC code。 */
#define APP_CARRIER_SYNC_DAC_MAX_CODE 4095U
/* 宏定义说明：APP_CARRIER_SYNC_DAC_REF_UV = 3300000UL；DAC 参考电压，单位微伏，用于电压到 code 的比例换算。 */
#define APP_CARRIER_SYNC_DAC_REF_UV   3300000UL

typedef struct
{
    app_carrier_sync_status_t status;          /* 对外可读状态快照。 */
    uint32_t last_update_tick;                 /* 上一次闭环调节的 RTOS tick。 */
    int64_t integral_uv_q16;                   /* PI 积分项，Q16 定点 uV，避免低频偏小 dt 时被整数截断。 */
} app_carrier_sync_ctx_t;

static app_carrier_sync_ctx_t g_carrier_sync;

/* 将目标电压限制在 VRFE 允许调整范围内。 */
static int32_t app_carrier_sync_clamp_uv(int32_t uv)
{
    /* 判断：`uv < APP_CARRIER_SYNC_MIN_UV`。含义：判断载波同步 DAC 调节是否需要执行或是否成功；成立后直接返回/退出当前函数或返回指定结果。 */
    if (uv < APP_CARRIER_SYNC_MIN_UV)
    {
        return APP_CARRIER_SYNC_MIN_UV;
    }

    /* 判断：`uv > APP_CARRIER_SYNC_MAX_UV`。含义：判断载波同步 DAC 调节是否需要执行或是否成功；成立后直接返回/退出当前函数或返回指定结果。 */
    if (uv > APP_CARRIER_SYNC_MAX_UV)
    {
        return APP_CARRIER_SYNC_MAX_UV;
    }

    return uv;
}

/* 将 64 位整数限制到 int32 范围，避免 PI 乘法中间值异常时溢出输出字段。 */
static int32_t app_carrier_sync_sat_i64_to_i32(int64_t value)
{
    /* 判断：计算值超过 int32 上限时，返回上限保护后续加法。 */
    if (value > 2147483647LL)
    {
        return 2147483647L;
    }

    /* 判断：计算值低于 int32 下限时，返回下限保护后续加法。 */
    if (value < (-2147483647LL - 1LL))
    {
        return (int32_t)(-2147483647L - 1L);
    }

    return (int32_t)value;
}

/* 将 PI 积分项限制到 VRFE 安全输出范围内，避免长时间失配导致积分饱和后恢复过慢。 */
static void app_carrier_sync_clamp_integral(void)
{
    int64_t min_i_q16 = ((int64_t)APP_CARRIER_SYNC_MIN_UV - (int64_t)APP_CARRIER_SYNC_CENTER_UV) << 16;
    int64_t max_i_q16 = ((int64_t)APP_CARRIER_SYNC_MAX_UV - (int64_t)APP_CARRIER_SYNC_CENTER_UV) << 16;

    /* 判断：积分项低于允许范围时夹到下限，防止 PI 输出继续向低压方向累积。 */
    if (g_carrier_sync.integral_uv_q16 < min_i_q16)
    {
        g_carrier_sync.integral_uv_q16 = min_i_q16;
    }

    /* 判断：积分项高于允许范围时夹到上限，防止 PI 输出继续向高压方向累积。 */
    if (g_carrier_sync.integral_uv_q16 > max_i_q16)
    {
        g_carrier_sync.integral_uv_q16 = max_i_q16;
    }
}

/* 根据实际经过时间计算本次积分步进，积分速度由 uV/s 决定，更新周期只影响输出颗粒度。 */
static int32_t app_carrier_sync_calc_freq_step_uv(uint32_t elapsed_ms)
{
    int64_t step_uv;

    /* 判断：积分斜率为 0 或经过时间为 0 时，本次不能产生有效控制步进。 */
    if ((APP_CARRIER_SYNC_FREQ_SLEW_UV_PER_SEC <= 0L) || (elapsed_ms == 0U))
    {
        return 0;
    }

    step_uv = ((int64_t)APP_CARRIER_SYNC_FREQ_SLEW_UV_PER_SEC * (int64_t)elapsed_ms) / 1000LL;

    /* 判断：计算结果小于 1uV 时，保留 1uV 最小有效步进，避免低速率下长期不动作。 */
    if (step_uv <= 0LL)
    {
        step_uv = 1LL;
    }

    /* 判断：步进超出 int32 表示范围时限幅，避免异常宏值导致整数溢出。 */
    if (step_uv > 2147483647LL)
    {
        step_uv = 2147483647LL;
    }

    return (int32_t)step_uv;
}

/* 根据残余频偏和 dt 更新 PI 项，返回 PI 计算出的目标 VRFE 电压。 */
static int32_t app_carrier_sync_calc_pi_target_uv(int32_t residual_mhz, uint32_t elapsed_ms)
{
    int64_t p_uv_raw;
    int64_t i_delta_q16;
    int32_t p_uv;
    int32_t i_uv;
    int64_t target_uv;

    /* P 项：mHz 转 Hz 后乘以 uV/Hz，控制极性统一在这里处理。 */
    p_uv_raw = ((int64_t)residual_mhz * (int64_t)APP_CARRIER_SYNC_FREQ_KP_UV_PER_HZ) / 1000LL;
    p_uv = app_carrier_sync_sat_i64_to_i32(p_uv_raw * (int64_t)APP_CARRIER_SYNC_CONTROL_POLARITY);

    /* I 项：mHz * ms 等价于 Hz*s 的 1e-6 倍，使用 Q16 保留小数累积。 */
    i_delta_q16 = (((int64_t)residual_mhz *
                    (int64_t)APP_CARRIER_SYNC_FREQ_KI_UV_PER_HZ_S *
                    (int64_t)elapsed_ms *
                    65536LL) /
                   1000000LL);
    g_carrier_sync.integral_uv_q16 += i_delta_q16 * (int64_t)APP_CARRIER_SYNC_CONTROL_POLARITY;
    app_carrier_sync_clamp_integral();

    i_uv = app_carrier_sync_sat_i64_to_i32(g_carrier_sync.integral_uv_q16 >> 16);
    target_uv = (int64_t)APP_CARRIER_SYNC_CENTER_UV + (int64_t)p_uv + (int64_t)i_uv;

    g_carrier_sync.status.p_term_uv = p_uv;
    g_carrier_sync.status.i_term_uv = i_uv;
    g_carrier_sync.status.target_uv = app_carrier_sync_clamp_uv(app_carrier_sync_sat_i64_to_i32(target_uv));

    return g_carrier_sync.status.target_uv;
}

/* 对 PI 目标电压做输出限速，防止 P/I 项变化过快直接大幅拉动 OCXO。 */
static int32_t app_carrier_sync_slew_to_target_uv(int32_t current_uv, int32_t target_uv, uint32_t elapsed_ms)
{
    int32_t max_step_uv;
    int32_t delta_uv = target_uv - current_uv;

    /* 函数跳转：调用 app_carrier_sync_calc_freq_step_uv()，把 uV/s 限速换算成本次允许的最大变化量。 */
    max_step_uv = app_carrier_sync_calc_freq_step_uv(elapsed_ms);
    /* 判断：限速步进为 0 时保持当前输出，避免无意义 DAC 写入。 */
    if (max_step_uv <= 0)
    {
        return current_uv;
    }

    /* 判断：目标电压高于当前电压且超出本次限速时，只向目标前进一步。 */
    if (delta_uv > max_step_uv)
    {
        return current_uv + max_step_uv;
    }

    /* 判断：目标电压低于当前电压且超出本次限速时，只向目标前进一步。 */
    if (delta_uv < -max_step_uv)
    {
        return current_uv - max_step_uv;
    }

    return target_uv;
}

/* 将 uV 电压转换成 12-bit DAC code，按 3.3V 参考电压计算。 */
static uint16_t app_carrier_sync_uv_to_dac_code(int32_t uv)
{
    /* 函数跳转：调用 app_carrier_sync_clamp_uv()，把控制电压限制在允许的最小/最大微伏范围内。 */
    int32_t safe_uv = app_carrier_sync_clamp_uv(uv);
    uint32_t code = (uint32_t)((((uint64_t)safe_uv * APP_CARRIER_SYNC_DAC_MAX_CODE) +
                                (APP_CARRIER_SYNC_DAC_REF_UV / 2ULL)) /
                               APP_CARRIER_SYNC_DAC_REF_UV);

    /* 判断：`code > APP_CARRIER_SYNC_DAC_MAX_CODE`。含义：判断载波同步 DAC 调节是否需要执行或是否成功；成立后更新相关状态变量/输出字段，然后继续后续流程。 */
    if (code > APP_CARRIER_SYNC_DAC_MAX_CODE)
    {
        code = APP_CARRIER_SYNC_DAC_MAX_CODE;
    }

    return (uint16_t)code;
}

/* 写入 DAC1_OUT1；第一次写入时同步启动 DAC 通道。 */
static void app_carrier_sync_apply_uv(int32_t uv)
{
    /* 函数跳转：调用 app_carrier_sync_uv_to_dac_code()，调用该函数进入对应子流程，执行完后返回当前时序继续向下运行。 */
    uint16_t code = app_carrier_sync_uv_to_dac_code(uv);

    /* 函数跳转：调用 app_carrier_sync_clamp_uv()，把控制电压限制在允许的最小/最大微伏范围内。 */
    g_carrier_sync.status.control_uv = app_carrier_sync_clamp_uv(uv);
    g_carrier_sync.status.dac_code = code;

/* 条件编译判断：判断 `(APP_CARRIER_SYNC_ENABLE != 0U)` 是否成立；成立时才编译下面代码块。 */
#if (APP_CARRIER_SYNC_ENABLE != 0U)
    /* 判断：`HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, code) != HAL_OK`。含义：判断载波同步 DAC 调节是否需要执行或是否成功；成立后更新相关状态变量/输出字段，然后继续后续流程。 */
    if (HAL_DAC_SetValue(&hdac1, DAC_CHANNEL_1, DAC_ALIGN_12B_R, code) != HAL_OK)
    {
        g_carrier_sync.status.last_error = -1;
        return;
    }

    /* 判断：`g_carrier_sync.status.dac_started == 0U`。含义：用于防空指针、未初始化、计数为 0 或开关关闭等边界条件；判断载波同步 DAC 调节是否需要执行或是否成功；成立后更新相关状态变量/输出字段，然后继续后续流程。 */
    if (g_carrier_sync.status.dac_started == 0U)
    {
        /* 判断：`HAL_DAC_Start(&hdac1, DAC_CHANNEL_1) != HAL_OK`。含义：判断载波同步 DAC 调节是否需要执行或是否成功；成立后更新相关状态变量/输出字段，然后继续后续流程。 */
        if (HAL_DAC_Start(&hdac1, DAC_CHANNEL_1) != HAL_OK)
        {
            g_carrier_sync.status.last_error = -2;
            return;
        }
        g_carrier_sync.status.dac_started = 1U;
    }
#endif

    g_carrier_sync.status.last_error = 0;
}

/* 初始化闭环状态，并让 VRFE 先回到 1.55V 中心点。 */
void app_carrier_sync_init(void)
{
    /* 函数跳转：调用 memset()，清零结构体或数组，避免上一阶段残留数据影响当前流程。 */
    memset(&g_carrier_sync, 0, sizeof(g_carrier_sync));
    g_carrier_sync.status.enabled = (APP_CARRIER_SYNC_ENABLE != 0U) ? 1U : 0U;
    /* 函数跳转：调用 app_carrier_sync_apply_uv()，把目标控制电压限幅并写到 DAC，更新当前同步状态。 */
    app_carrier_sync_apply_uv(APP_CARRIER_SYNC_CENTER_UV);
}

/* 退出锁定态或重新扫频时回到中心点，避免沿用上一轮积分偏置。 */
void app_carrier_sync_reset_to_center(void)
{
    g_carrier_sync.status.locked_gate = 0U;
    g_carrier_sync.status.residual_freq_millihz = 0;
    g_carrier_sync.status.p_term_uv = 0;
    g_carrier_sync.status.i_term_uv = 0;
    g_carrier_sync.status.target_uv = APP_CARRIER_SYNC_CENTER_UV;
    g_carrier_sync.integral_uv_q16 = 0;
    /* 函数跳转：调用 osKernelGetTickCount()，读取 RTOS tick，用于记录扫频开始/结束或控制更新间隔。 */
    g_carrier_sync.last_update_tick = osKernelGetTickCount();
    /* 函数跳转：调用 app_carrier_sync_apply_uv()，把目标控制电压限幅并写到 DAC，更新当前同步状态。 */
    app_carrier_sync_apply_uv(APP_CARRIER_SYNC_CENTER_UV);
}

/* 锁定后按残余频偏执行 PI 控制，并对输出变化做限速保护。 */
void app_carrier_sync_update(uint8_t locked_gate, const app_iq_preproc_result_t *iq_result)
{
    uint32_t now_tick;
    uint32_t elapsed_ms;
    int32_t residual;
    int32_t abs_residual;
    int32_t target_uv;
    int32_t next_uv;

    /* 判断：`(APP_CARRIER_SYNC_ENABLE == 0U) || (g_carrier_sync.status.enabled == 0U)`。含义：用于防空指针、未初始化、计数为 0 或开关关闭等边界条件；判断载波同步 DAC 调节是否需要执行或是否成功；成立后直接返回/退出当前函数或返回指定结果。 */
    if ((APP_CARRIER_SYNC_ENABLE == 0U) || (g_carrier_sync.status.enabled == 0U))
    {
        return;
    }

    /* 判断：`(locked_gate == 0U) || (iq_result == NULL)`。含义：用于防空指针、未初始化、计数为 0 或开关关闭等边界条件；确认扫频锁定门控是否允许后级处理；成立后调用 app_carrier_sync_reset_to_center()：把载波同步控制电压复位到中心值。 */
    if ((locked_gate == 0U) || (iq_result == NULL))
    {
        /* 判断：`g_carrier_sync.status.locked_gate != 0U`。含义：用于防空指针、未初始化、计数为 0 或开关关闭等边界条件；确认扫频锁定门控是否允许后级处理；成立后调用 app_carrier_sync_reset_to_center()：把载波同步控制电压复位到中心值。 */
        if (g_carrier_sync.status.locked_gate != 0U)
        {
            /* 函数跳转：调用 app_carrier_sync_reset_to_center()，把载波同步控制电压复位到中心值。 */
            app_carrier_sync_reset_to_center();
        }
        g_carrier_sync.status.locked_gate = 0U;
        g_carrier_sync.status.hold_count++;
        return;
    }

    /* 函数跳转：调用 osKernelGetTickCount()，读取 RTOS tick，用于记录扫频开始/结束或控制更新间隔。 */
    now_tick = osKernelGetTickCount();
    residual = iq_result->residual_freq_millihz;
    abs_residual = (residual >= 0) ? residual : -residual;
    g_carrier_sync.status.residual_freq_millihz = residual;

    /* 判断：刚从未锁定进入锁定时，只同步时间基准，不立刻积分，避免扫频耗时被误算成本次 dt。 */
    if (g_carrier_sync.status.locked_gate == 0U)
    {
        g_carrier_sync.status.locked_gate = 1U;
        g_carrier_sync.last_update_tick = now_tick;
        g_carrier_sync.status.hold_count++;
        return;
    }

    elapsed_ms = now_tick - g_carrier_sync.last_update_tick;
    /* 判断：频率环执行节拍未到时直接返回；这里只限制计算频率，不再用它隐式代表积分强度。 */
    if (elapsed_ms < APP_CARRIER_SYNC_FREQ_UPDATE_PERIOD_MS)
    {
        return;
    }

    /* 判断：`abs_residual <= APP_CARRIER_SYNC_DEADBAND_MHZ`。含义：判断载波同步 DAC 调节是否需要执行或是否成功；成立后更新相关状态变量/输出字段，然后继续后续流程。 */
    if (abs_residual <= APP_CARRIER_SYNC_DEADBAND_MHZ)
    {
        g_carrier_sync.status.p_term_uv = 0;
        g_carrier_sync.last_update_tick = now_tick;
        g_carrier_sync.status.hold_count++;
        return;
    }

    /* 函数跳转：调用 app_carrier_sync_calc_pi_target_uv()，按 P/I 项计算本次目标 VRFE 电压。 */
    target_uv = app_carrier_sync_calc_pi_target_uv(residual, elapsed_ms);
    /* 函数跳转：调用 app_carrier_sync_slew_to_target_uv()，对 PI 目标做输出限速保护。 */
    next_uv = app_carrier_sync_slew_to_target_uv(g_carrier_sync.status.control_uv, target_uv, elapsed_ms);
    /* 函数跳转：调用 app_carrier_sync_clamp_uv()，把控制电压限制在允许的最小/最大微伏范围内。 */
    next_uv = app_carrier_sync_clamp_uv(next_uv);

    /* 函数跳转：调用 app_carrier_sync_apply_uv()，把目标控制电压限幅并写到 DAC，更新当前同步状态。 */
    app_carrier_sync_apply_uv(next_uv);
    g_carrier_sync.last_update_tick = now_tick;
    g_carrier_sync.status.update_count++;
}

/* 返回当前闭环状态快照。 */
void app_carrier_sync_get_status(app_carrier_sync_status_t *status_out)
{
    /* 判断：`status_out == NULL`。含义：用于防空指针、未初始化、计数为 0 或开关关闭等边界条件；成立后直接返回/退出当前函数或返回指定结果。 */
    if (status_out == NULL)
    {
        return;
    }

    *status_out = g_carrier_sync.status;
}
