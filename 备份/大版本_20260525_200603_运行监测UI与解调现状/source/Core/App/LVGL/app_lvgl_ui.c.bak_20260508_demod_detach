void App_LvglUiRefresh(void)
{
  app_signal_detect_status_t st;
  app_mod_detect_status_t mod_st;
  app_demod_status_t demod_st;
  uint32_t now_tick = osKernelGetTickCount();
  char freq_buf[32];
  char left_edge_buf[32];
  char right_edge_buf[32];
  char param_buf[128];
  app_mod_detect_mode_t display_mode;

  if ((uint32_t)(now_tick - g_ui.last_refresh_tick) < UI_REFRESH_PERIOD_MS)
  {
    return;
  }
  g_ui.last_refresh_tick = now_tick;

  app_signal_detect_get_status(&st);
  app_mod_detect_get_status(&mod_st);
  app_demod_get_status(&demod_st);

  if (st.scanning != 0U)
  {
    App_LvglUiFormatFreq(freq_buf, sizeof(freq_buf), st.current_lo_hz);
    lv_label_set_text_fmt(g_ui.scan_status,
                          (st.stage == APP_SIGDET_STAGE_VPP_FINE_SCAN) ? "Status: VPP FINE (%u/%u)" : "Status: VPP COARSE (%u/%u)",
                          (unsigned)(st.step_index + 1U),
                          (unsigned)st.step_count);
  }
  else if (st.stage == APP_SIGDET_STAGE_VPP_LOCKED)
  {
    App_LvglUiFormatFreq(freq_buf, sizeof(freq_buf), st.estimated_carrier_hz);
    if (st.carrier_present == 0U)
    {
      lv_label_set_text(g_ui.scan_status, "Status: NO VPP RESPONSE");
    }
    else if (st.locked != 0U)
    {
      lv_label_set_text(g_ui.scan_status, "Status: VPP LOCKED");
    }
    else
    {
      lv_label_set_text(g_ui.scan_status, "Status: VPP CANDIDATE");
    }
  }
  else if (st.carrier_present != 0U)
  {
    App_LvglUiFormatFreq(freq_buf, sizeof(freq_buf), st.estimated_carrier_hz);
    lv_label_set_text(g_ui.scan_status, "Status: CARRIER DETECTED");
  }
  else
  {
    snprintf(freq_buf, sizeof(freq_buf), "--.--- MHz");
    lv_label_set_text(g_ui.scan_status, "Status: NO CARRIER");
  }

  lv_label_set_text(g_ui.freq_value, freq_buf);
  App_LvglUiFormatFreq(left_edge_buf, sizeof(left_edge_buf), st.left_edge_hz);
  App_LvglUiFormatFreq(right_edge_buf, sizeof(right_edge_buf), st.right_edge_hz);
  lv_label_set_text_fmt(g_ui.quality_line,
                        "Vpp: cur=%lu I=%lu Q=%lu peak=%lu valley=%lu\nEdge: L=%s R=%s th=%lu",
                        (unsigned long)st.current_vpp_raw,
                        (unsigned long)st.current_i_vpp_raw,
                        (unsigned long)st.current_q_vpp_raw,
                        (unsigned long)st.peak_vpp_raw,
                        (unsigned long)st.valley_vpp_raw,
                        left_edge_buf,
                        right_edge_buf,
                        (unsigned long)st.threshold_vpp_raw);
  if ((st.stage == APP_SIGDET_STAGE_VPP_LOCKED) &&
      (st.locked != 0U) &&
      (st.carrier_present != 0U) &&
      (mod_st.block_count > 0UL))
  {
    display_mode = (mod_st.stable_confidence_percent >= 55U) ? mod_st.stable_mode : mod_st.mode;
    App_LvglUiFormatModParams(param_buf, sizeof(param_buf), display_mode, &mod_st);
    lv_label_set_text_fmt(g_ui.mod_value,
                          "Mode: %s\nConf:%u%% Inst:%s\nBlocks:%lu",
                          app_mod_detect_mode_name(display_mode),
                          (unsigned)mod_st.stable_confidence_percent,
                          app_mod_detect_mode_name(mod_st.mode),
                          (unsigned long)mod_st.block_count);
    lv_label_set_text(g_ui.demod_value, param_buf);
    lv_label_set_text_fmt(g_ui.spectrum_value,
                          "Features: env=%lu edge=%lu freq=%lu psk=%lu hist=%u\nSign: +%u%% -%u%%  rate=%luHz  dev=%luHz\nFFT: not enabled; reserve for rate/deviation refinement",
                          (unsigned long)mod_st.env_variation_pm,
                          (unsigned long)mod_st.env_edge_pm,
                          (unsigned long)mod_st.freq_activity,
                          (unsigned long)mod_st.psk_jump_pm,
                          (unsigned)mod_st.dphi_hist_peak_count,
                          (unsigned)mod_st.positive_freq_percent,
                          (unsigned)mod_st.negative_freq_percent,
                          (unsigned long)mod_st.modulation_rate_hz,
                          (unsigned long)mod_st.fm_deviation_hz);
  }
  else
  {
    lv_label_set_text(g_ui.mod_value, "Mode: --\nBlocks: 0");
    lv_label_set_text(g_ui.demod_value, "Parameters: --");
    lv_label_set_text(g_ui.spectrum_value,
                      "Waiting for locked carrier and modulation blocks...\nFFT: reserved for next algorithm stage");
  }

  (void)demod_st;
  if (g_ui.current_page == APP_UI_PAGE_DEMOD)
  {
    App_LvglUiRefreshDemodPage(&st, &mod_st);
  }
}

