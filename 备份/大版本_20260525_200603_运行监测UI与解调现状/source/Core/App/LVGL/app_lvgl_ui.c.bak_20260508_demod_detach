static void App_LvglUiFormatFreq(char *out, uint32_t out_len, uint32_t hz)
{
  snprintf(out,
           out_len,
           "%lu.%03lu MHz",
           (unsigned long)(hz / 1000000UL),
           (unsigned long)((hz % 1000000UL) / 1000UL));
}

static void App_LvglUiFormatRate(char *out, uint32_t out_len, uint32_t hz)
{
  if (hz >= 1000UL)
  {
    snprintf(out,
             out_len,
             "%lu.%01lu kHz",
             (unsigned long)(hz / 1000UL),
             (unsigned long)((hz % 1000UL) / 100UL));
  }
  else
  {
    snprintf(out, out_len, "%lu Hz", (unsigned long)hz);
  }
}

static void App_LvglUiFormatPermillePercent(char *out, uint32_t out_len, uint32_t permille)
{
  snprintf(out,
           out_len,
           "%lu.%01lu%%",
           (unsigned long)(permille / 10UL),
           (unsigned long)(permille % 10UL));
}

static void App_LvglUiFormatModParams(char *out,
                                      uint32_t out_len,
                                      app_mod_detect_mode_t mode,
                                      const app_mod_detect_status_t *mod_st)
{
  char rate_buf[24];
  char depth_buf[24];
  char dev_buf[24];

  App_LvglUiFormatRate(rate_buf, sizeof(rate_buf), mod_st->modulation_rate_hz);
  App_LvglUiFormatPermillePercent(depth_buf, sizeof(depth_buf), mod_st->am_depth_pm);
  App_LvglUiFormatRate(dev_buf, sizeof(dev_buf), mod_st->fm_deviation_hz);

  switch (mode)
  {
    case APP_MODDET_MODE_AM:
      snprintf(out, out_len, "AM Depth: %s\nMod Rate: %s\nEnvelope: %lu pm",
               depth_buf,
               rate_buf,
               (unsigned long)mod_st->env_variation_pm);
      break;
    case APP_MODDET_MODE_ASK:
      snprintf(out, out_len, "ASK Depth: %s\nSymbol Rate: %s\nEdge: %lu pm",
               depth_buf,
               rate_buf,
               (unsigned long)mod_st->env_edge_pm);
      break;
    case APP_MODDET_MODE_FM:
      snprintf(out, out_len, "FM Dev(avg): %s\nMod Rate: %s\nFreqAct: %lu pm",
               dev_buf,
               rate_buf,
               (unsigned long)mod_st->freq_activity);
      break;
    case APP_MODDET_MODE_FSK:
      App_LvglUiFormatRate(dev_buf, sizeof(dev_buf), mod_st->fsk_shift_hz);
      snprintf(out, out_len, "FSK Shift(avg): %s\nSymbol Rate: %s\nSign: +%u%%/-%u%%",
               dev_buf,
               rate_buf,
               (unsigned)mod_st->positive_freq_percent,
               (unsigned)mod_st->negative_freq_percent);
      break;
    case APP_MODDET_MODE_PSK:
      snprintf(out, out_len, "PSK Rate(est): %s\nJump: %lu pm\nSign: +%u%%/-%u%%",
               rate_buf,
               (unsigned long)mod_st->psk_jump_pm,
               (unsigned)mod_st->positive_freq_percent,
               (unsigned)mod_st->negative_freq_percent);
      break;
    case APP_MODDET_MODE_CW:
      snprintf(out, out_len, "CW / No modulation\nDev(avg): %s\nDepth: %s",
               dev_buf,
               depth_buf);
      break;
    case APP_MODDET_MODE_NO_CARRIER:
      snprintf(out, out_len, "No carrier\nParameters: --");
      break;
    case APP_MODDET_MODE_UNKNOWN:
    default:
      snprintf(out, out_len, "Unknown modulation\nRate: %s\nDepth: %s",
               rate_buf,
               depth_buf);
      break;
  }
}

