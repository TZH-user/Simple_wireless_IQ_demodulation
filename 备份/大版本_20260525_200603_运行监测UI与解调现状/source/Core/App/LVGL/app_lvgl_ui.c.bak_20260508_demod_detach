    if (page == APP_UI_PAGE_DETECT)
    {
      lv_obj_remove_flag(g_ui.detect_page, LV_OBJ_FLAG_HIDDEN);
    }
    else
    {
      lv_obj_add_flag(g_ui.detect_page, LV_OBJ_FLAG_HIDDEN);
    }
  }

  if (g_ui.demod_page != NULL)
  {
    if (page == APP_UI_PAGE_DEMOD)
    {
      lv_obj_remove_flag(g_ui.demod_page, LV_OBJ_FLAG_HIDDEN);
    }
    else
    {
      lv_obj_add_flag(g_ui.demod_page, LV_OBJ_FLAG_HIDDEN);
    }
  }
}

static void App_LvglUiEnterDemodEvent(lv_event_t *e)
{
  (void)e;

  app_demod_set_mode(APP_MODDET_MODE_AM);
  app_demod_reset_output();
  app_demod_set_active(1U);
  demod_task_set_enabled(1U);

  App_LvglUiShowPage(APP_UI_PAGE_DEMOD);
}

static void App_LvglUiExitDemodEvent(lv_event_t *e)
{
  (void)e;

  demod_task_set_enabled(0U);
  app_demod_set_active(0U);
  app_demod_reset_output();

  App_LvglUiShowPage(APP_UI_PAGE_DETECT);
}

static void App_LvglUiRefreshDemodPage(const app_signal_detect_status_t *sig_st,
                                       const app_mod_detect_status_t *mod_st)
{
  app_demod_status_t demod_st;
  char lo_buf[32];
  char carrier_buf[32];
  char rate_buf[24];
  uint32_t y_peak = 128U;

  app_demod_get_status(&demod_st);

  App_LvglUiFormatFreq(lo_buf, sizeof(lo_buf), sig_st->demod_lo_hz);
  App_LvglUiFormatFreq(carrier_buf, sizeof(carrier_buf), sig_st->estimated_carrier_hz);
  App_LvglUiFormatRate(rate_buf, sizeof(rate_buf), mod_st->modulation_rate_hz);

  if ((demod_st.mode == APP_MODDET_MODE_AM) && (demod_st.output_valid != 0U))
  {
    uint16_t n = demod_st.waveform_len;
    if (n > APP_DEMOD_WAVE_POINTS)
    {
      n = APP_DEMOD_WAVE_POINTS;
    }

    for (uint32_t i = 0U; i < APP_DEMOD_WAVE_POINTS; ++i)
    {
      g_ui.demod_chart_points[i] = (i < n) ? demod_st.waveform[i] : 0;
    }

    if (demod_st.peak_abs > y_peak)
    {
      y_peak = demod_st.peak_abs;
    }
    if (y_peak > 8192U)
    {
      y_peak = 8192U;
    }

    lv_chart_set_range(g_ui.demod_chart, LV_CHART_AXIS_PRIMARY_Y, -(int32_t)y_peak, (int32_t)y_peak);
    lv_chart_refresh(g_ui.demod_chart);

    lv_label_set_text_fmt(g_ui.demod_state,
                          "State: running  Mode:%s  Blocks:%lu",
                          app_mod_detect_mode_name(demod_st.mode),
                          (unsigned long)demod_st.block_count);

    lv_label_set_text_fmt(g_ui.demod_info,
                          "Wave: valid  Peak:%lu  DC:%ld\nRate(est): %s\nLO:%s  Carrier:%s\nModDet stable:%s conf:%u%%",
                          (unsigned long)demod_st.peak_abs,
                          (long)demod_st.dc_estimate,
                          rate_buf,
                          lo_buf,
                          carrier_buf,
                          app_mod_detect_mode_name(mod_st->stable_mode),
                          (unsigned)mod_st->stable_confidence_percent);
  }
  else
  {
    for (uint32_t i = 0U; i < APP_DEMOD_WAVE_POINTS; ++i)
    {
      g_ui.demod_chart_points[i] = 0;
    }
    lv_chart_set_range(g_ui.demod_chart, LV_CHART_AXIS_PRIMARY_Y, -1024, 1024);
    lv_chart_refresh(g_ui.demod_chart);

    lv_label_set_text_fmt(g_ui.demod_state,
                          "State: idle / unsupported  Mode:%s",
                          app_mod_detect_mode_name(demod_st.mode));

    lv_label_set_text_fmt(g_ui.demod_info,
                          "Wave: not available\nRate(est): %s\nLO:%s  Carrier:%s\nOnly AM is implemented in v1",
                          rate_buf,
                          lo_buf,
                          carrier_buf);
  }
}

