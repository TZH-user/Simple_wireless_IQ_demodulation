#include "SI5351.h"

#include "RtosTypes.h"
#include "cmsis_os2.h"
#include "i2c.h"

#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>

#define SI5351_I2C_ADDR0            (0x60U << 1)
#define SI5351_I2C_ADDR1            (0x61U << 1)
#define SI5351_I2C_TIMEOUT_MS       50U
#define SI5351_STARTUP_RETRY_MS     200U
#define SI5351_MONITOR_PERIOD_MS    200U
#define SI5351_LOCK_TIMEOUT_MS      100U

#define SI5351_REG_DEVICE_STATUS    0U
#define SI5351_REG_INTERRUPT_STATUS 1U
#define SI5351_REG_OUTPUT_ENABLE    3U
#define SI5351_REG_OEB_MASK         9U
#define SI5351_REG_PLL_INPUT        15U
#define SI5351_REG_CLK0_CTRL        16U
#define SI5351_REG_PLLA_PARAMS      26U
#define SI5351_REG_MS0_PARAMS       42U
#define SI5351_REG_PLL_RESET        177U

#define SI5351_STATUS_SYS_INIT      0x80U
#define SI5351_STATUS_LOL_A         0x20U
#define SI5351_STATUS_LOS_CLKIN     0x10U

#define SI5351_CLK0_ENABLE_BIT      0x01U

typedef enum
{
    SI5351_FAULT_NONE = 0,
    SI5351_FAULT_DEVICE_NOT_FOUND,
    SI5351_FAULT_SYS_INIT_TIMEOUT,
    SI5351_FAULT_I2C_WRITE,
    SI5351_FAULT_I2C_READ,
    SI5351_FAULT_CLKIN_LOST,
    SI5351_FAULT_PLL_UNLOCKED
} si5351_fault_t;

static volatile uint8_t g_si5351_clock_ready = 0U;
static uint16_t g_si5351_i2c_addr = 0U;
static uint8_t g_si5351_output_enable = 0xFFU;

static void si5351_log_text(const char *text)
{
    if ((text != NULL) && (g_uart_mode == UART_MODE_LOG))
    {
        print_queue_send_log(text);
    }
}

static void si5351_log_fault(si5351_fault_t fault, HAL_StatusTypeDef status)
{
    static char log_buf[96];
    const char *reason = "unknown";

    switch (fault)
    {
    case SI5351_FAULT_DEVICE_NOT_FOUND:
        reason = "device_not_found";
        break;
    case SI5351_FAULT_SYS_INIT_TIMEOUT:
        reason = "sys_init_timeout";
        break;
    case SI5351_FAULT_I2C_WRITE:
        reason = "i2c_write";
        break;
    case SI5351_FAULT_I2C_READ:
        reason = "i2c_read";
        break;
    case SI5351_FAULT_CLKIN_LOST:
        reason = "clkin_lost";
        break;
    case SI5351_FAULT_PLL_UNLOCKED:
        reason = "plla_unlock";
        break;
    default:
        reason = "none";
        break;
    }

    (void)snprintf(log_buf,
                   sizeof(log_buf),
                   "si5351: fault=%s hal=%ld\r\n",
                   reason,
                   (long)status);
    si5351_log_text(log_buf);
}

static HAL_StatusTypeDef si5351_write_reg(uint8_t reg, uint8_t value)
{
    return HAL_I2C_Mem_Write(&hi2c1,
                             g_si5351_i2c_addr,
                             reg,
                             I2C_MEMADD_SIZE_8BIT,
                             &value,
                             1U,
                             SI5351_I2C_TIMEOUT_MS);
}

static HAL_StatusTypeDef si5351_write_block(uint8_t start_reg, const uint8_t *data, uint16_t size)
{
    return HAL_I2C_Mem_Write(&hi2c1,
                             g_si5351_i2c_addr,
                             start_reg,
                             I2C_MEMADD_SIZE_8BIT,
                             (uint8_t *)data,
                             size,
                             SI5351_I2C_TIMEOUT_MS);
}

static HAL_StatusTypeDef si5351_read_reg(uint8_t reg, uint8_t *value)
{
    return HAL_I2C_Mem_Read(&hi2c1,
                            g_si5351_i2c_addr,
                            reg,
                            I2C_MEMADD_SIZE_8BIT,
                            value,
                            1U,
                            SI5351_I2C_TIMEOUT_MS);
}

static HAL_StatusTypeDef si5351_probe_device(void)
{
    static const uint16_t addr_candidates[] = {
        SI5351_I2C_ADDR0,
        SI5351_I2C_ADDR1,
    };
    uint32_t idx;

    for (idx = 0U; idx < (sizeof(addr_candidates) / sizeof(addr_candidates[0])); idx++)
    {
        if (HAL_I2C_IsDeviceReady(&hi2c1,
                                  addr_candidates[idx],
                                  3U,
                                  SI5351_I2C_TIMEOUT_MS) == HAL_OK)
        {
            g_si5351_i2c_addr = addr_candidates[idx];
            return HAL_OK;
        }
    }

    g_si5351_i2c_addr = 0U;
    return HAL_ERROR;
}

static HAL_StatusTypeDef si5351_wait_for_sys_init_clear(void)
{
    uint32_t elapsed_ms = 0U;
    uint8_t status = 0U;
    HAL_StatusTypeDef hal_status;

    while (elapsed_ms < SI5351_LOCK_TIMEOUT_MS)
    {
        hal_status = si5351_read_reg(SI5351_REG_DEVICE_STATUS, &status);
        if (hal_status != HAL_OK)
        {
            return hal_status;
        }

        if ((status & SI5351_STATUS_SYS_INIT) == 0U)
        {
            return HAL_OK;
        }

        osDelay(5U);
        elapsed_ms += 5U;
    }

    return HAL_TIMEOUT;
}

static HAL_StatusTypeDef si5351_set_clk0_enable(bool enable)
{
    if (enable)
    {
        g_si5351_output_enable &= (uint8_t)(~SI5351_CLK0_ENABLE_BIT);
    }
    else
    {
        g_si5351_output_enable |= SI5351_CLK0_ENABLE_BIT;
    }

    return si5351_write_reg(SI5351_REG_OUTPUT_ENABLE, g_si5351_output_enable);
}

static HAL_StatusTypeDef si5351_program_fixed_plan(void)
{
    static const uint8_t plla_from_10m_to_800m[8] = {
        0x00U, 0x01U, 0x00U, 0x26U, 0x00U, 0x00U, 0x00U, 0x00U,
    };
    static const uint8_t ms0_from_800m_to_25m[8] = {
        0x00U, 0x01U, 0x00U, 0x0EU, 0x00U, 0x00U, 0x00U, 0x00U,
    };
    HAL_StatusTypeDef hal_status;

    g_si5351_output_enable = 0xFFU;
    hal_status = si5351_write_reg(SI5351_REG_OUTPUT_ENABLE, g_si5351_output_enable);
    if (hal_status != HAL_OK)
    {
        return hal_status;
    }

    hal_status = si5351_write_reg(SI5351_REG_OEB_MASK, 0xFFU);
    if (hal_status != HAL_OK)
    {
        return hal_status;
    }

    hal_status = si5351_write_reg(SI5351_REG_PLL_INPUT, 0x04U);
    if (hal_status != HAL_OK)
    {
        return hal_status;
    }

    hal_status = si5351_write_block(SI5351_REG_PLLA_PARAMS,
                                    plla_from_10m_to_800m,
                                    (uint16_t)sizeof(plla_from_10m_to_800m));
    if (hal_status != HAL_OK)
    {
        return hal_status;
    }

    hal_status = si5351_write_block(SI5351_REG_MS0_PARAMS,
                                    ms0_from_800m_to_25m,
                                    (uint16_t)sizeof(ms0_from_800m_to_25m));
    if (hal_status != HAL_OK)
    {
        return hal_status;
    }

    hal_status = si5351_write_reg(SI5351_REG_CLK0_CTRL, 0x4FU);
    if (hal_status != HAL_OK)
    {
        return hal_status;
    }

    hal_status = si5351_write_reg(SI5351_REG_INTERRUPT_STATUS, 0x00U);
    if (hal_status != HAL_OK)
    {
        return hal_status;
    }

    return si5351_write_reg(SI5351_REG_PLL_RESET, 0xA0U);
}

static si5351_fault_t si5351_start_clock(HAL_StatusTypeDef *hal_status)
{
    uint32_t elapsed_ms = 0U;
    uint8_t status = 0U;

    *hal_status = si5351_probe_device();
    if (*hal_status != HAL_OK)
    {
        return SI5351_FAULT_DEVICE_NOT_FOUND;
    }

    *hal_status = si5351_wait_for_sys_init_clear();
    if (*hal_status != HAL_OK)
    {
        return SI5351_FAULT_SYS_INIT_TIMEOUT;
    }

    *hal_status = si5351_program_fixed_plan();
    if (*hal_status != HAL_OK)
    {
        return SI5351_FAULT_I2C_WRITE;
    }

    while (elapsed_ms < SI5351_LOCK_TIMEOUT_MS)
    {
        *hal_status = si5351_read_reg(SI5351_REG_DEVICE_STATUS, &status);
        if (*hal_status != HAL_OK)
        {
            return SI5351_FAULT_I2C_READ;
        }

        if ((status & SI5351_STATUS_LOS_CLKIN) != 0U)
        {
            (void)si5351_set_clk0_enable(false);
            return SI5351_FAULT_CLKIN_LOST;
        }

        if ((status & SI5351_STATUS_LOL_A) == 0U)
        {
            *hal_status = si5351_set_clk0_enable(true);
            if (*hal_status != HAL_OK)
            {
                return SI5351_FAULT_I2C_WRITE;
            }
            g_si5351_clock_ready = 1U;
            return SI5351_FAULT_NONE;
        }

        osDelay(5U);
        elapsed_ms += 5U;
    }

    (void)si5351_set_clk0_enable(false);
    return SI5351_FAULT_PLL_UNLOCKED;
}

bool app_si5351_is_clock_ready(void)
{
    return (g_si5351_clock_ready != 0U);
}

void StartSI5351(void *argument)
{
    HAL_StatusTypeDef hal_status = HAL_OK;
    si5351_fault_t last_fault = SI5351_FAULT_NONE;
    uint8_t status = 0U;
    static char log_buf[96];

    (void)argument;

    for (;;)
    {
        if (!app_si5351_is_clock_ready())
        {
            si5351_fault_t fault = si5351_start_clock(&hal_status);
            if (fault == SI5351_FAULT_NONE)
            {
                (void)snprintf(log_buf,
                               sizeof(log_buf),
                               "si5351: ready addr=0x%02X clk0=25MHz clkin=10MHz\r\n",
                               (unsigned int)(g_si5351_i2c_addr >> 1));
                si5351_log_text(log_buf);
                last_fault = SI5351_FAULT_NONE;
                osDelay(SI5351_MONITOR_PERIOD_MS);
                continue;
            }

            if (fault != last_fault)
            {
                si5351_log_fault(fault, hal_status);
                last_fault = fault;
            }
            g_si5351_clock_ready = 0U;
            osDelay(SI5351_STARTUP_RETRY_MS);
            continue;
        }

        hal_status = si5351_read_reg(SI5351_REG_DEVICE_STATUS, &status);
        if (hal_status != HAL_OK)
        {
            (void)si5351_set_clk0_enable(false);
            g_si5351_clock_ready = 0U;
            if (last_fault != SI5351_FAULT_I2C_READ)
            {
                si5351_log_fault(SI5351_FAULT_I2C_READ, hal_status);
                last_fault = SI5351_FAULT_I2C_READ;
            }
            osDelay(SI5351_STARTUP_RETRY_MS);
            continue;
        }

        if ((status & SI5351_STATUS_LOS_CLKIN) != 0U)
        {
            (void)si5351_set_clk0_enable(false);
            g_si5351_clock_ready = 0U;
            if (last_fault != SI5351_FAULT_CLKIN_LOST)
            {
                si5351_log_fault(SI5351_FAULT_CLKIN_LOST, hal_status);
                last_fault = SI5351_FAULT_CLKIN_LOST;
            }
            osDelay(SI5351_STARTUP_RETRY_MS);
            continue;
        }

        if ((status & SI5351_STATUS_LOL_A) != 0U)
        {
            (void)si5351_set_clk0_enable(false);
            g_si5351_clock_ready = 0U;
            if (last_fault != SI5351_FAULT_PLL_UNLOCKED)
            {
                si5351_log_fault(SI5351_FAULT_PLL_UNLOCKED, hal_status);
                last_fault = SI5351_FAULT_PLL_UNLOCKED;
            }
            osDelay(SI5351_STARTUP_RETRY_MS);
            continue;
        }

        last_fault = SI5351_FAULT_NONE;
        osDelay(SI5351_MONITOR_PERIOD_MS);
    }
}
